# Copie para .env e preencha. O arquivo .env não vai para o git.
# Sem estas variáveis o app funciona em "modo local" (dados só no aparelho).

# Servidor Parse (ex.: Back4App). Use a Client key, nunca a Master key.
EXPO_PUBLIC_PARSE_SERVER_URL=https://parseapi.back4app.com
EXPO_PUBLIC_PARSE_APP_ID=
EXPO_PUBLIC_PARSE_CLIENT_KEY=

# Chave do Google Maps para o build Android (não é necessária no Expo Go).
GOOGLE_MAPS_API_KEY=

# Token público do Mapbox (pk.*) para os mapas. Sem ele, usa OpenStreetMap.
# Crie em https://account.mapbox.com/access-tokens/ e restrinja por URL.
EXPO_PUBLIC_MAPBOX_TOKEN=
